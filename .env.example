# Application Environment Configuration
APP_ENV=development
APP_NAME="Traffic Violation Detection System"
DEBUG=true
LOG_LEVEL=INFO

# API & Server Settings
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Video / Camera Ingestion
DEFAULT_RTSP_URL=data/sample_traffic.mp4
FRAME_WIDTH=1920
FRAME_HEIGHT=1080
TARGET_FPS=30

# AI Models & Inference
VEHICLE_DETECTOR_MODEL=yolov8n.pt
PLATE_DETECTOR_MODEL=models/checkpoints/plate_detector.pt
DEVICE=cuda:0 # or 'cpu'
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.50

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=sqlite:///./traffic_violations.db
# For PostgreSQL production:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/traffic_db

# Redis & Celery Task Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage (MinIO / S3)
STORAGE_BACKEND=local # 'local' or 's3'
LOCAL_STORAGE_DIR=./data/evidence
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=traffic-evidence
